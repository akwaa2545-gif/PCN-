SQL_SERVER=svr120a
SQL_DATABASE=Scn_DB
SQL_USER=scndb
SQL_PASSWORD=
SQL_PORT=1433
SQL_TRUST_SERVER_CERTIFICATE=false
SQL_POOL_MAX=10
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Staged rollout: configure AD, create a separate Windows administrator, then enable Windows sign-in.
AUTH_MODE=password
# AD DNS domain for read-only employee lookup; backend Windows identity must have AD read access.
AD_DOMAIN=
# Windows mode additionally requires HOST=127.0.0.1 and TRUST_PROXY=loopback behind IIS.
# Explicit AD NetBIOS domain (verify with Get-ADDomain); do not infer it from the DNS domain.
WINDOWS_AUTH_DOMAIN=
# Private random 32-256 printable characters, shared only with the IIS proxy configuration.
# IIS must overwrite the identity/key headers; never expose this value to the browser.
WINDOWS_AUTH_PROXY_KEY=
# HTTPS deployment: NODE_ENV=production and PUBLIC_ORIGIN=https://your-approved-domain
# Windows service: private config outside release/source control; absolute path required.
# PCN_ENV_FILE=C:\ProgramData\SupplierPCN\config\pcn.env
# Store the fixed signed mail URL only in private server config, never browser/GitHub settings.
# Keep these blank in the committed template; health checks never send a test email.
POWER_AUTOMATE_MAIL_URL=
POWER_AUTOMATE_DIRECTORY_URL=
# Comma-separated exact HTTPS endpoint hostnames (no URLs, paths or signatures).
INTEGRATION_ALLOWED_HOSTS=
# Health is read-only: GET /api/admin/notifications/health; no remote flow probe.
# Recipients remain editable in Admin Mail Routing; empty groups have no fallback.
# One-time bootstrap values are supplied privately, not committed:
PCN_BOOTSTRAP_USERNAME=
PCN_BOOTSTRAP_PASSWORD=
PCN_BOOTSTRAP_EMAIL=
