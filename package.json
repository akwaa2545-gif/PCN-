{
  "name": "supplier-pcn-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "Supplier PCN workflow with SQL Server persistence and application user authentication.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:e2e": "node scripts/e2e-smoke.js",
    "db:check": "node scripts/db-check.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:import": "node scripts/db-import.js",
    "user:assign-id": "node scripts/assign-employee-id.js",
    "start:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-pcn.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "mssql": "^12.7.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
